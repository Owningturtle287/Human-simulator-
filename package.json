{
  "name": "human-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "train": "node scripts/train.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.3.0",
    "@types/three": "^0.183.1",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.65.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
